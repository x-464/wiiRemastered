{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "fs:allow-read",
    "fs:allow-read-dir",
    "fs:read-all",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$APPDATA/generated_pngs"
        },
        {
          "path": "$APPDATA/generated_pngs/**"
        }
      ]
    }
  ]
}
